# Sepolia RPC used for all on-chain reads (vault state, balances, event logs).
# Leave empty to fall back to viem's default public Sepolia RPC.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# WalletConnect Cloud project ID for the RainbowKit modal: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
