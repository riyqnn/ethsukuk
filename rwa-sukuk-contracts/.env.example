# ===== Wallet =====
# Private key of the deployer (protocol/treasury). NEVER commit a funded key.
PRIVATE_KEY=

# ===== RPC URLs =====
SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
POLYGON_AMOY_RPC_URL=

# ===== Underlying =====
# Official IDRX address on the target network. Leave empty to deploy MockIDRX (dev/testnet only).
# IDRX_ADDRESS=

# ===== Roles =====
# Gnosis Safe that holds AUDITOR_ROLE (closes subscription, opens redemption).
AUDITOR_MULTISIG=
# Gnosis Safe that custodies the deployed principal. Defaults to AUDITOR_MULTISIG.
# TREASURY_SAFE=
# Optional: address to receive PROTOCOL_ROLE (defaults to the deployer).
# PROTOCOL_ADMIN=

# ===== Issue terms (scripts/deploy-certificate.ts) =====
# Production values are a 3-year tenor with profit every 90 days. Shorten both on a testnet
# so the whole lifecycle can be walked through in one session.
ISSUE_NAME="Sukuk Certificate Series I"
ISSUE_SYMBOL=SUKUK1
ISSUE_ISIN=
ISSUE_QUOTA=20000
ISSUE_DENOMINATION=100
TENOR_SECONDS=94608000
COUPON_INTERVAL_SECONDS=7776000
COUPON_RATE_BPS=1200

# ===== Etherscan API v2 (single key covers all chains) =====
# Get a free key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
